{
  "protocol_version": "v1",
  "configuration_version": "experimental_v1",
  "engine": {
    "praat_version": "6.4.27"
  },
  "input": {
    "channels": 1,
    "sample_rates_hz": [
      44100,
      48000
    ],
    "preprocessing": "none"
  },
  "selection": {
    "mode": "manual",
    "vowel": "a",
    "central_window_s": 3.0
  },
  "pitch": {
    "method": "raw_cross_correlation",
    "floor_hz": 75.0,
    "ceiling_hz": 600.0,
    "time_step_s": 0.005,
    "max_candidates": 15,
    "very_accurate": false,
    "silence_threshold": 0.03,
    "voicing_threshold": 0.45,
    "octave_cost": 0.01,
    "octave_jump_cost": 0.35,
    "voiced_unvoiced_cost": 0.14
  },
  "pulses": {
    "method": "Sound & Pitch: To PointProcess (cc)"
  },
  "perturbation": {
    "period_floor_s": 0.0013333333333333335,
    "period_ceiling_s": 0.016666666666666666,
    "maximum_period_factor": 1.3,
    "maximum_amplitude_factor": 1.6,
    "jitter_variant": "local_percent",
    "shimmer_variant": "local_percent"
  },
  "harmonicity": {
    "method": "cc",
    "time_step_s": 0.01,
    "minimum_pitch_hz": 75.0,
    "silence_threshold": 0.1,
    "periods_per_window": 4.5,
    "aggregation": "mean_db_valid_frames"
  },
  "scope": {
    "implemented": [
      "whole_file_duration"
    ],
    "not_implemented": [
      "segment_duration",
      "f0_mean",
      "f0_sd",
      "jitter_local",
      "shimmer_local",
      "hnr_cc"
    ],
    "excluded": [
      "cpp",
      "cpps",
      "diagnosis"
    ]
  }
}
